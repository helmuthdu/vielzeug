{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!common",
      "!scripts",
      "!**/scripts",
      // Symlinked agent skills resolve into packages/*/skills; Biome has no Markdown handler.
      "!.agents",
      "!**/dist",
      "!docs/.vitepress/cache",
      "!docs/.vitepress/theme/components/repl/registry.generated.ts",
      // Wrangler-generated Worker types are outputs, not authored source.
      "!**/worker-configuration.d.ts",
      // SVGs are exported artwork (Inkscape), not authored source: inline CSS uses
      // Inkscape-specific properties and font names that Biome flags.
      "!**/*.svg",
      // CHANGELOGs are release-train outputs (apply-train rewrites them every train); linting
      // them makes the gate flaky against the generator's fixed template instead of source.
      "!**/CHANGELOG.md"
    ]
  },
  "formatter": {
    "bracketSameLine": true,
    "bracketSpacing": true,
    "enabled": true,
    "expand": "auto",
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "useEditorconfig": true
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "indentScriptAndStyle": false,
      "selfCloseVoidElements": "always",
      "whitespaceSensitivity": "ignore"
    }
  },
  "javascript": {
    "formatter": {
      "bracketSameLine": true,
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "complexity": {
        "useOptionalChain": "off"
      },
      "correctness": {
        "noInvalidUseBeforeDeclaration": "off",
        "noUnsafeOptionalChaining": "off"
      },
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noConfusingVoidType": "off",
        "noExplicitAny": "off",
        "noExportsInTest": "off",
        "noNonNullAssertedOptionalChain": "off",
        "noRedeclare": "off",
        "noShadowRestrictedNames": "off",
        "noThenProperty": "off"
      }
    }
  },
  "markdown": {
    "parser": {
      // Opt-in, and required: without it the Markdown formatter reads `---` as a
      // thematic break, so a VitePress frontmatter block becomes prose (a blank line
      // after the opening `---`, and a `title:` line that ends at the closing `---`
      // turns into a setext `## title: ...` heading). Upstream: biomejs/biome#12537.
      "frontmatter": true
    }
  },
  "overrides": [
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off",
            "useSortedProperties": "off"
          }
        }
      },
      "formatter": {
        "enabled": false
      },
      "includes": ["package.json", "demos/*/package.json", "packages/*/package.json"]
    },
    {
      "includes": ["docs/**/*.vue"],
      "linter": {
        "rules": {
          "a11y": {
            // VitePress theme uses div overlays/backdrops where <button> isn't semantically right
            // (no focusable content, pure click area). Re-enable when Biome supports dismiss-role.
            "useSemanticElements": "off"
          },
          "style": {
            // Scoped styles in Vue SFCs routinely need descending specificity for overrides.
            "noDescendingSpecificity": "off",
            // VitePress theme components are referenced by filename in config, not imported as
            // Vue SFC components: single-word/acronym names like REPL.vue are intentional.
            "useVueMultiWordComponentNames": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      // YAML embedded in Markdown frontmatter keeps the authored style (single
      // quotes, no bracket padding), matching the 791 existing frontmatter values.
      // Scoped here so the real .yml/.yaml files keep Biome's defaults.
      "includes": ["docs/**/*.md", "packages/**/skills/**/SKILL.md"],
      "yaml": {
        "formatter": {
          "bracketSpacing": false,
          "lineWidth": 120,
          "quoteStyle": "single"
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
