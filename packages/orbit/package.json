{
  "name": "@vielzeug/orbit",
  "version": "26.11.8",
  "description": "Floating UI positioning with lifecycle-owned geometry and middleware",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/orbit"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./devtools": {
      "import": "./dist/devtools.js",
      "require": "./dist/devtools.cjs",
      "types": "./dist/devtools.d.ts"
    },
    "./presets": {
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs",
      "types": "./dist/presets.d.ts"
    },
    "./reactive": {
      "import": "./dist/reactive.js",
      "require": "./dist/reactive.cjs",
      "types": "./dist/reactive.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "devtools": [
        "dist/devtools.d.ts"
      ],
      "presets": [
        "dist/presets.d.ts"
      ],
      "reactive": [
        "dist/reactive.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && bun run --silent build:bundle && bun run --silent build:types",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "biome check --write src",
    "lint": "biome ci src",
    "prepublishOnly": "bun run --silent build",
    "test": "vitest"
  },
  "dependencies": {
    "@vielzeug/arsenal": "workspace:*"
  },
  "peerDependencies": {
    "@vielzeug/ripple": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@vielzeug/ripple": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vielzeug/ripple": "workspace:*",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
