{
  "name": "@vielzeug/spell",
  "version": "1.2.2",
  "description": "Schema-first validation and parsing — runtime type checking, coercion, and custom refinements",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./json": {
      "source": "./src/json.ts",
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js",
      "require": "./dist/json.cjs"
    },
    "./predicates": {
      "source": "./src/predicates.ts",
      "types": "./dist/predicates.d.ts",
      "import": "./dist/predicates.js",
      "require": "./dist/predicates.cjs"
    }
  },
  "scripts": {
    "build": "vite build && pnpm run build:bundle && pnpm run build:types",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "eslint --fix src",
    "lint": "eslint src",
    "prepublishOnly": "pnpm run build",
    "preview": "vite preview",
    "test": "pnpm test:types && vitest",
    "test:types": "tsc -p tsconfig.types.json",
    "build:bundle": "vite build --config vite.bundle.config.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@vielzeug/arsenal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
