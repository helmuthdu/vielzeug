{
  "name": "@vielzeug/courier",
  "version": "26.11.15",
  "description": "Typed HTTP client with bounded structured-key caching, prefetching, immutable middleware, and structured errors",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/courier"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && bun run --silent build:bundle && bun run --silent build:types && bun run --silent test:types && bun run --silent verify:exports",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "biome check --write src",
    "lint": "biome ci src",
    "prepublishOnly": "bun run --silent build",
    "preview": "vite preview",
    "test": "vitest",
    "test:types": "tsc -p tsconfig.type-tests.json && tsc -p tsconfig.node-tests.json",
    "verify:exports": "bun verify-exports.mjs"
  },
  "dependencies": {
    "@vielzeug/arsenal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
