{
  "name": "@vielzeug/arsenal",
  "version": "26.10.5",
  "description": "Non-trivial TypeScript utilities: retry, cancellation, cache, safe-path, serialization, prototype-pollution-guarded collections",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/arsenal"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./array": {
      "types": "./dist/array/index.d.ts",
      "import": "./dist/array/index.js",
      "require": "./dist/array/index.cjs"
    },
    "./async": {
      "types": "./dist/async/index.d.ts",
      "import": "./dist/async/index.js",
      "require": "./dist/async/index.cjs"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js",
      "require": "./dist/cache/index.cjs"
    },
    "./encoding": {
      "types": "./dist/encoding/index.d.ts",
      "import": "./dist/encoding/index.js",
      "require": "./dist/encoding/index.cjs"
    },
    "./function": {
      "types": "./dist/function/index.d.ts",
      "import": "./dist/function/index.js",
      "require": "./dist/function/index.cjs"
    },
    "./guards": {
      "types": "./dist/guards/index.d.ts",
      "import": "./dist/guards/index.js",
      "require": "./dist/guards/index.cjs"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.js",
      "require": "./dist/math/index.cjs"
    },
    "./object": {
      "types": "./dist/object/index.d.ts",
      "import": "./dist/object/index.js",
      "require": "./dist/object/index.cjs"
    },
    "./random": {
      "types": "./dist/random/index.d.ts",
      "import": "./dist/random/index.js",
      "require": "./dist/random/index.cjs"
    },
    "./string": {
      "types": "./dist/string/index.d.ts",
      "import": "./dist/string/index.js",
      "require": "./dist/string/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "array": [
        "dist/array/index.d.ts"
      ],
      "async": [
        "dist/async/index.d.ts"
      ],
      "cache": [
        "dist/cache/index.d.ts"
      ],
      "encoding": [
        "dist/encoding/index.d.ts"
      ],
      "function": [
        "dist/function/index.d.ts"
      ],
      "guards": [
        "dist/guards/index.d.ts"
      ],
      "math": [
        "dist/math/index.d.ts"
      ],
      "object": [
        "dist/object/index.d.ts"
      ],
      "random": [
        "dist/random/index.d.ts"
      ],
      "string": [
        "dist/string/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm --silent run verify:exports && vite build && pnpm --silent run build:bundle && pnpm --silent run build:types",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "biome check --write src",
    "lint": "biome ci src",
    "prepublishOnly": "pnpm --silent run build",
    "preview": "vite preview",
    "sync:exports": "node ./scripts/sync-exports.mjs",
    "test": "pnpm --silent run verify:exports && vitest",
    "verify:exports": "node ./scripts/sync-exports.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
