  "scripts": {
    "analyze": "custom-elements-manifest analyze --config scripts/refine-manifest.mjs",
    "build": "pnpm run check:theme && pnpm run check:manifest && pnpm run check:css-contract && vite build && pnpm run build:bundle && cp -r src/styles/*.css dist/styles && pnpm run build:types && pnpm run analyze && pnpm run gen:framework-types",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:bundle:watch": "vite build --watch --config vite.bundle.config.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "check:css-contract": "node ./scripts/check-css-contract.mjs",
    "check:manifest": "node ./scripts/refine-manifest.mjs check-exports",
    "check:theme": "node ./scripts/theme-tokens.mjs check",
    "dev": "vite",
    "fix": "biome check --write src",
    "gen:framework-types": "node ./scripts/generate-framework-types.mjs",
    "lint": "biome ci src",
    "preview": "vite preview",
    "sync:exports": "node ./scripts/refine-manifest.mjs sync-exports",
    "sync:theme": "node ./scripts/theme-tokens.mjs sync",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
