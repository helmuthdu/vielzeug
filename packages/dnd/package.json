{
  "name": "@vielzeug/dnd",
  "version": "2.2.0",
  "description": "Framework-agnostic drag-and-drop — sortable lists, file-drop zones, and MIME-type filtering",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/dnd"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./drop": {
      "import": "./dist/drop.js",
      "require": "./dist/drop.cjs",
      "types": "./dist/drop.d.ts"
    },
    "./sortable": {
      "import": "./dist/sortable.js",
      "require": "./dist/sortable.cjs",
      "types": "./dist/sortable.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "drop": [
        "dist/drop.d.ts"
      ],
      "sortable": [
        "dist/sortable.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && pnpm --silent run build:bundle && pnpm --silent run build:types && pnpm --silent run test:types && pnpm --silent run verify:exports",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "biome check --write src",
    "lint": "biome ci src",
    "prepublishOnly": "pnpm --silent run build",
    "test": "vitest",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "verify:exports": "node verify-exports.mjs"
  },
  "dependencies": {
    "@vielzeug/gesture": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
