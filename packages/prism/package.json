{
  "name": "@vielzeug/prism",
  "version": "26.11.6",
  "description": "Responsive SVG charts with explicit updates: line, bar, area, scatter, pie, radar, heatmap, sparkline",
  "keywords": [
    "chart",
    "svg",
    "visualization",
    "responsive",
    "line-chart",
    "bar-chart",
    "area-chart",
    "scatter-chart",
    "radar-chart",
    "typescript"
  ],
  "homepage": "https://vielzeug.dev/prism/",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/prism"
  },
  "bugs": {
    "url": "https://github.com/helmuthdu/vielzeug/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./theme.css": "./dist/theme/prism.css"
  },
  "sideEffects": [
    "./dist/theme/**"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && bun run --silent build:bundle && mkdir -p dist/theme && cp src/theme/prism.css dist/theme/prism.css && bun run --silent build:types",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "biome check --write src",
    "lint": "biome ci src",
    "prepublishOnly": "bun run --silent build",
    "test": "vitest"
  },
  "dependencies": {
    "@vielzeug/orbit": "workspace:*"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
