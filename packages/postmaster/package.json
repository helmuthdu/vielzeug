{
  "name": "@vielzeug/postmaster",
  "version": "3.0.0",
  "description": "Typed durable job outbox with leased processing, retries, and dead-letter recovery",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/postmaster"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./indexeddb": {
      "import": "./dist/indexeddb.js",
      "require": "./dist/indexeddb.cjs",
      "types": "./dist/indexeddb.d.ts"
    },
    "./store": {
      "import": "./dist/store.js",
      "require": "./dist/store.cjs",
      "types": "./dist/store.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs",
      "types": "./dist/testing.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "indexeddb": [
        "dist/indexeddb.d.ts"
      ],
      "store": [
        "dist/store.d.ts"
      ],
      "testing": [
        "dist/testing.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && pnpm --silent run build:bundle && pnpm --silent run build:types",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "biome check --write src",
    "lint": "biome ci src",
    "prepublishOnly": "pnpm --silent run build",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@vielzeug/arsenal": "workspace:*",
    "@vielzeug/vault": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vielzeug/courier": "workspace:*",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
