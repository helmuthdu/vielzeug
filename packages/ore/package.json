{
  "name": "@vielzeug/ore",
  "version": "2.0.3",
  "description": "Custom element authoring primitives — reactive templates, signals, slots, and automatic lifecycle management",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "scripts": {
    "build": "vite build && pnpm run build:bundle && pnpm run build:types",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "eslint --fix src vitest.setup.ts",
    "lint": "eslint src vitest.setup.ts",
    "prepublishOnly": "pnpm run build",
    "preview": "vite preview",
    "test": "vitest",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "build:bundle": "vite build --config vite.bundle.config.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@vielzeug/assay": "workspace:^",
    "@vielzeug/ripple": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@vielzeug/assay": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vielzeug/assay": "workspace:*",
    "@vielzeug/ripple": "workspace:*",
    "axe-core": "^4.12.1",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing/index.d.ts"
      ]
    }
  }
}
