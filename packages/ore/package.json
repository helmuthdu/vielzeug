{
  "name": "@vielzeug/ore",
  "version": "26.11.7",
  "description": "Functional web-component authoring on top of ripple",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/ore"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && bun run --silent build:bundle && bun run --silent build:types",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "biome check --write src vitest.setup.ts",
    "lint": "biome ci src vitest.setup.ts",
    "prepublishOnly": "bun run --silent build",
    "preview": "vite preview",
    "test": "vitest",
    "test:types": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@vielzeug/assay": "workspace:^",
    "@vielzeug/ripple": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@vielzeug/assay": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vielzeug/assay": "workspace:*",
    "@vielzeug/ripple": "workspace:*",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
