{
  "name": "@vielzeug/codex",
  "version": "3.0.4",
  "description": "MCP server exposing all Vielzeug docs to AI clients",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/codex"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "data",
    "dist",
    "mcp-setup.json"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js"
    },
    "./refine": {
      "types": "./dist/refine.d.ts",
      "import": "./dist/refine.js"
    }
  },
  "typesVersions": {
    "*": {
      "advanced": [
        "dist/advanced.d.ts"
      ],
      "refine": [
        "dist/refine.d.ts"
      ]
    }
  },
  "bin": {
    "codex": "./dist/cli.js"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm --silent run prepare:data && rm -rf dist && tsc && pnpm --silent run verify:exports",
    "dev": "node --experimental-strip-types ./scripts/dev.ts",
    "fix": "biome check --write src",
    "gen:tool-docs": "node --experimental-strip-types ./scripts/generate-tool-docs.ts",
    "lint": "biome ci src",
    "prepare:data": "node --experimental-strip-types ./scripts/generate-bundled-data.ts",
    "prepublishOnly": "pnpm --silent run build",
    "start": "node dist/cli.js",
    "test": "pnpm --silent run test:unit && pnpm --silent run test:integration",
    "test:integration": "pnpm --silent run prepare:data && vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "verify:exports": "node verify-exports.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vielzeug/refine": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
