{
  "name": "@vielzeug/codex",
  "version": "26.11.6",
  "description": "MCP server exposing all Vielzeug docs to AI clients",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/codex"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "data",
    "dist",
    "mcp-setup.json",
    "skills"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./refine": {
      "types": "./dist/refine.d.ts",
      "import": "./dist/refine.js"
    }
  },
  "typesVersions": {
    "*": {
      "refine": [
        "dist/refine.d.ts"
      ]
    }
  },
  "bin": {
    "codex": "./dist/cli.js"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run --silent prepare:data && rm -rf dist && tsc && bun run --silent verify:exports",
    "dev": "bun ./scripts/dev.ts",
    "fix": "biome check --write src",
    "gen:tool-docs": "bun ./scripts/generate-tool-docs.ts",
    "lint": "biome ci src",
    "prepare:data": "bun ./scripts/generate-bundled-data.ts",
    "prepublishOnly": "bun run --silent build",
    "start": "bun dist/cli.js",
    "test": "bun run --silent test:unit && bun run --silent test:integration",
    "test:integration": "bun run --silent prepare:data && vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "verify:exports": "bun verify-exports.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vielzeug/refine": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
