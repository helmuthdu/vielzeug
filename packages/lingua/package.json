{
  "name": "@vielzeug/lingua",
  "version": "2.4.1",
  "description": "Explicit typed localization with pluralization, lazy locale catalogs, and SSR hydration",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/lingua"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./format": {
      "import": "./dist/format.js",
      "require": "./dist/format.cjs",
      "types": "./dist/format.d.ts"
    },
    "./validate": {
      "import": "./dist/validate.js",
      "require": "./dist/validate.cjs",
      "types": "./dist/validate.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "format": [
        "dist/format.d.ts"
      ],
      "validate": [
        "dist/validate.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm --silent run typecheck && vite build && pnpm --silent run build:bundle && pnpm --silent run build:types && pnpm --silent run verify:exports",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "biome check --write src",
    "lint": "biome ci src",
    "prepublishOnly": "pnpm --silent run build",
    "preview": "vite preview",
    "test": "pnpm --silent run typecheck && vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:exports": "node ./scripts/verify-exports.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
