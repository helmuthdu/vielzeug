{
  "name": "@vielzeug/sandbox",
  "version": "26.11.16",
  "description": "Sandboxed iframe runtime with typed postMessage state bridge",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/sandbox"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs",
      "types": "./dist/testing.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && bun run --silent build:bundle && bun run --silent build:types && bun run --silent test:types",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "biome check --write src",
    "lint": "biome ci src",
    "prepublishOnly": "bun run --silent build",
    "test": "vitest",
    "test:types": "tsc -p tsconfig.type-tests.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
