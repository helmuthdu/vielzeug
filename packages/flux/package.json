{
  "name": "@vielzeug/flux",
  "version": "2.3.0",
  "description": "Minimal push streams with explicit ownership, buffering, and ecosystem adapters",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/flux"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./async": {
      "import": "./dist/async.js",
      "require": "./dist/async.cjs",
      "types": "./dist/async.d.ts"
    },
    "./courier": {
      "import": "./dist/courier.js",
      "require": "./dist/courier.cjs",
      "types": "./dist/courier.d.ts"
    },
    "./herald": {
      "import": "./dist/herald.js",
      "require": "./dist/herald.cjs",
      "types": "./dist/herald.d.ts"
    },
    "./pulse": {
      "import": "./dist/pulse.js",
      "require": "./dist/pulse.cjs",
      "types": "./dist/pulse.d.ts"
    },
    "./ripple": {
      "import": "./dist/ripple.js",
      "require": "./dist/ripple.cjs",
      "types": "./dist/ripple.d.ts"
    },
    "./subjects": {
      "import": "./dist/subjects.js",
      "require": "./dist/subjects.cjs",
      "types": "./dist/subjects.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "async": [
        "dist/async.d.ts"
      ],
      "courier": [
        "dist/courier.d.ts"
      ],
      "herald": [
        "dist/herald.d.ts"
      ],
      "pulse": [
        "dist/pulse.d.ts"
      ],
      "ripple": [
        "dist/ripple.d.ts"
      ],
      "subjects": [
        "dist/subjects.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && pnpm run build:bundle && pnpm run build:types && pnpm run verify:exports",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "biome check --write src",
    "lint": "biome ci src",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "verify:exports": "node scripts/verify-exports.mjs && node scripts/verify-package-exports.mjs"
  },
  "peerDependencies": {
    "@vielzeug/courier": "workspace:*",
    "@vielzeug/herald": "workspace:*",
    "@vielzeug/pulse": "workspace:*",
    "@vielzeug/ripple": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@vielzeug/courier": {
      "optional": true
    },
    "@vielzeug/herald": {
      "optional": true
    },
    "@vielzeug/pulse": {
      "optional": true
    },
    "@vielzeug/ripple": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vielzeug/courier": "workspace:*",
    "@vielzeug/herald": "workspace:*",
    "@vielzeug/pulse": "workspace:*",
    "@vielzeug/ripple": "workspace:*",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
