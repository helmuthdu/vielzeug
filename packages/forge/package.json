{
  "name": "@vielzeug/forge",
  "version": "2.2.1",
  "description": "Immutable typed form state with focused fields and explicit full-form validation",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/forge"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dom": {
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs",
      "types": "./dist/dom.d.ts"
    },
    "./form-data": {
      "import": "./dist/form-data.js",
      "require": "./dist/form-data.cjs",
      "types": "./dist/form-data.d.ts"
    },
    "./spell": {
      "import": "./dist/spell.js",
      "require": "./dist/spell.cjs",
      "types": "./dist/spell.d.ts"
    },
    "./vault": {
      "import": "./dist/vault.js",
      "require": "./dist/vault.cjs",
      "types": "./dist/vault.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "dom": [
        "dist/dom.d.ts"
      ],
      "form-data": [
        "dist/form-data.d.ts"
      ],
      "spell": [
        "dist/spell.d.ts"
      ],
      "vault": [
        "dist/vault.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && pnpm run build:bundle && pnpm run build:types",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "biome check --write src",
    "lint": "biome ci src",
    "prepublishOnly": "pnpm run build",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {},
  "peerDependencies": {
    "@vielzeug/spell": "workspace:*",
    "@vielzeug/vault": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@vielzeug/spell": {
      "optional": true
    },
    "@vielzeug/vault": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vielzeug/spell": "workspace:*",
    "@vielzeug/vault": "workspace:*",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
