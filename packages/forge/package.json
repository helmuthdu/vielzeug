{
  "name": "@vielzeug/forge",
  "version": "26.11.5",
  "description": "Typed form state, validation, submission",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/forge"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dom": {
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs",
      "types": "./dist/dom.d.ts"
    },
    "./form-data": {
      "import": "./dist/form-data.js",
      "require": "./dist/form-data.cjs",
      "types": "./dist/form-data.d.ts"
    },
    "./persist": {
      "import": "./dist/persist.js",
      "require": "./dist/persist.cjs",
      "types": "./dist/persist.d.ts"
    },
    "./schema": {
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs",
      "types": "./dist/schema.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "dom": [
        "dist/dom.d.ts"
      ],
      "form-data": [
        "dist/form-data.d.ts"
      ],
      "persist": [
        "dist/persist.d.ts"
      ],
      "schema": [
        "dist/schema.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && bun run --silent build:bundle && bun run --silent build:types && bun run --silent test:types && bun run --silent verify:exports",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "biome check --write src",
    "lint": "biome ci src",
    "prepublishOnly": "bun run --silent build",
    "preview": "vite preview",
    "test": "vitest",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "verify:exports": "bun verify-exports.mjs"
  },
  "dependencies": {
    "@vielzeug/arsenal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vielzeug/spell": "workspace:*",
    "@vielzeug/vault": "workspace:*",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
