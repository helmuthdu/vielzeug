{
  "name": "@vielzeug/forge",
  "version": "1.4.0",
  "description": "Immutable typed form state with focused fields and explicit full-form validation",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./devtools": {
      "source": "./src/devtools.ts",
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js",
      "require": "./dist/devtools.cjs"
    },
    "./dom": {
      "source": "./src/dom.ts",
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs"
    },
    "./spell": {
      "source": "./src/spell.ts",
      "types": "./dist/spell.d.ts",
      "import": "./dist/spell.js",
      "require": "./dist/spell.cjs"
    },
    "./vault": {
      "source": "./src/vault.ts",
      "types": "./dist/vault.d.ts",
      "import": "./dist/vault.js",
      "require": "./dist/vault.cjs"
    }
  },
  "scripts": {
    "build": "vite build && pnpm run build:bundle && pnpm run build:types",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "eslint --fix src",
    "lint": "eslint src",
    "prepublishOnly": "pnpm run build",
    "preview": "vite preview",
    "test": "vitest",
    "build:bundle": "vite build --config vite.bundle.config.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@vielzeug/arsenal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vielzeug/spell": "workspace:*",
    "@vielzeug/vault": "workspace:*",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@vielzeug/spell": "workspace:*",
    "@vielzeug/vault": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@vielzeug/spell": {
      "optional": true
    },
    "@vielzeug/vault": {
      "optional": true
    }
  }
}
