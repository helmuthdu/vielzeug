{
  "name": "@vielzeug/archive",
  "version": "26.10.22",
  "description": "Community content publishing for Cloudflare Workers + D1: a hardened Worker core over per-collection payload schemas",
  "repository": {
    "type": "git",
    "url": "https://github.com/helmuthdu/vielzeug",
    "directory": "packages/archive"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "require": "./dist/worker.cjs"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "require": "./dist/auth.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "worker": [
        "dist/worker.d.ts"
      ],
      "auth": [
        "dist/auth.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && pnpm --silent run build:types",
    "build:types": "tsc -p tsconfig.declarations.json",
    "fix": "biome check --write src test",
    "lint": "biome ci src test",
    "prepublishOnly": "pnpm --silent run build",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vielzeug/spell": "workspace:*",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "4.151.2"
  }
}
