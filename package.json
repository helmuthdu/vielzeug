{
  "name": "vielzeug",
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "root": true,
  "scripts": {
    "build": "rush build",
    "check:ai-data": "node scripts/sync-ai-data.mjs --check",
    "check:package-manifests": "node scripts/sync-package-manifests.mjs --check",
    "ci:local": "act -W .github/workflows/ci.yml",
    "docs:build": "pnpm gen:repl-registry && vitepress build docs",
    "docs:dev": "pnpm gen:repl-registry && vitepress dev docs",
    "docs:dev:refine": "concurrently --no-kill-others -c \"auto\" \"pnpm --filter @vielzeug/refine build:bundle:watch\" \"pnpm docs:dev\"",
    "docs:preview": "vitepress preview docs",
    "fix": "biome check --write .",
    "gen:ai-data": "node scripts/sync-ai-data.mjs",
    "gen:repl-registry": "node --import jiti/register scripts/generate-repl-registry.ts",
    "lint": "biome ci .",
    "prepare": "lefthook install",
    "release:publish-local": "node scripts/release/local-publish.mjs",
    "setup": "rush install",
    "sync:package-manifests": "node scripts/sync-package-manifests.mjs",
    "test": "vitest",
    "validate:docs": "node --import jiti/register scripts/validate-docs.ts",
    "validate:repl": "node --import jiti/register scripts/validate-repl.ts",
    "verify:packed": "node scripts/verify-packed-packages.mjs",
    "verify:prod-gate": "node scripts/verify-prod-gate.mjs",
    "worktree:add": "node scripts/worktree.mjs add",
    "worktree:list": "node scripts/worktree.mjs list",
    "worktree:remove": "node scripts/worktree.mjs remove"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "browserslist": "^4.28.8",
    "concurrently": "^10.0.4",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "lightningcss": "^1.33.0",
    "monaco-editor": "0.56.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitepress": "^2.0.0-alpha.18",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  }
}
