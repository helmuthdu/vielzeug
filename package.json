{
  "name": "vielzeug",
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "root": true,
  "workspaces": [
    "packages/*",
    "demos/*"
  ],
  "scripts": {
    "apply:codemod": "bun scripts/codemods/apply.ts",
    "build": "bun run --filter './packages/*' build",
    "check:ai-data": "bun scripts/sync-ai-data.mjs --check",
    "check:change-files": "bun scripts/validate-change-files.mjs",
    "check:package-manifests": "bun scripts/sync-package-manifests.mjs --check",
    "ci:local": "act -W .github/workflows/ci.yml",
    "docs:build": "bun run gen:repl-registry && vitepress build docs",
    "docs:dev": "bun run gen:repl-registry && vitepress dev docs",
    "docs:dev:refine": "concurrently --no-kill-others -c \"auto\" \"bun run --filter @vielzeug/refine build:bundle:watch\" \"bun run docs:dev\"",
    "docs:preview": "vitepress preview docs",
    "fix": "biome check --write .",
    "gen:ai-data": "bun scripts/sync-ai-data.mjs",
    "gen:repl-registry": "bun scripts/generate-repl-registry.ts",
    "lint": "biome ci .",
    "new:package": "bun scripts/new-package.mjs",
    "prepare": "lefthook install",
    "release:publish-local": "bun scripts/release/local-publish.mjs",
    "site:build": "bun scripts/build-site.mjs",
    "sync:package-manifests": "bun scripts/sync-package-manifests.mjs",
    "test": "vitest",
    "validate:demos": "bun run --filter './demos/*' build && bun run --filter './demos/*' test",
    "validate:docs": "bun scripts/validate-docs.ts",
    "validate:readme": "bun scripts/validate-readme.ts",
    "validate:repl": "bun scripts/validate-repl.ts",
    "validate:sidebar": "bun scripts/validate-sidebar.ts",
    "verify:packed": "bun scripts/verify-packed-packages.mjs",
    "verify:prod-gate": "bun scripts/verify-prod-gate.mjs",
    "worktree:add": "bun scripts/worktree.mjs add",
    "worktree:list": "bun scripts/worktree.mjs list",
    "worktree:remove": "bun scripts/worktree.mjs remove"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "browserslist": "^4.29.5",
    "concurrently": "^10.0.6",
    "jsdom": "^31.0.0",
    "lefthook": "^2.2.2",
    "lightningcss": "^1.33.0",
    "lucide": "^1.70.0",
    "monaco-editor": "0.57.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  },
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "playwright",
    "rs-module-lexer"
  ]
}
