{
  "inputs": [
    {
      "description": "Package name (e.g. spell, ripple, courier)",
      "id": "packageName",
      "type": "promptString"
    }
  ],
  "tasks": [
    {
      "args": ["run", "--filter", "./packages/${input:packageName}", "build"],
      "command": "bun",
      "detail": "Build a package (ESM + CJS + types)",
      "group": "build",
      "label": "pkg: build",
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": ["$tsc"],
      "type": "shell"
    },
    {
      "args": ["x", "vitest", "run", "packages/${input:packageName}/src/__tests__/"],
      "command": "bun",
      "detail": "Run all tests for a package (single run)",
      "group": { "isDefault": true, "kind": "test" },
      "label": "pkg: test",
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": ["x", "vitest", "packages/${input:packageName}/src/__tests__/"],
      "command": "bun",
      "detail": "Run tests in watch mode for a package",
      "group": "test",
      "isBackground": true,
      "label": "pkg: test watch",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": ["run", "--filter", "./packages/${input:packageName}", "lint"],
      "command": "bun",
      "detail": "Lint a package with Biome",
      "group": "build",
      "label": "pkg: lint",
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": ["run", "--filter", "./packages/${input:packageName}", "fix"],
      "command": "bun",
      "detail": "Auto-fix Biome diagnostics and sort imports/keys for a package",
      "group": "build",
      "label": "pkg: fix",
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "bun run --filter ./packages/${input:packageName} fix && bun run --filter ./packages/${input:packageName} lint && bun x vitest run packages/${input:packageName}/src/__tests__/",
      "detail": "Auto-fix, then verify lint and tests pass (full quality gate)",
      "group": "build",
      "label": "pkg: fix → lint → test",
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": ["run", "build"],
      "command": "bun",
      "detail": "Build all packages (topological, parallel within each level)",
      "group": "build",
      "label": "monorepo: build all",
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": ["$tsc"],
      "type": "shell"
    },
    {
      "args": ["run", "test"],
      "command": "bun",
      "detail": "Run the full Vitest suite across all packages",
      "group": "test",
      "label": "monorepo: test all",
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": ["run", "lint"],
      "command": "bun",
      "detail": "Lint every package with Biome",
      "group": "build",
      "label": "monorepo: lint all",
      "presentation": { "panel": "shared", "reveal": "always" },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": ["run", "docs:dev"],
      "command": "bun",
      "detail": "Start the VitePress docs dev server",
      "group": "build",
      "isBackground": true,
      "label": "docs: dev",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": [],
      "type": "shell"
    }
  ],
  "version": "2.0.0"
}
