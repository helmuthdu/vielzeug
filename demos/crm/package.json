{
  "name": "vielzeug-crm-demo",
  "version": "0.0.0",
  "private": true,
  "description": "A fictional B2B CRM showcasing the Vielzeug ecosystem.",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build:local": "node --experimental-strip-types scripts/write-local-tsconfig.ts && tsc -p tsconfig.local-dev.json && VIELZEUG_LOCAL_DEV=1 vite build",
    "dev": "vite",
    "dev:local": "VIELZEUG_LOCAL_DEV=1 vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vielzeug/clockwork": "workspace:*",
    "@vielzeug/coins": "workspace:*",
    "@vielzeug/conduit": "workspace:*",
    "@vielzeug/courier": "workspace:*",
    "@vielzeug/dnd": "workspace:*",
    "@vielzeug/familiar": "workspace:*",
    "@vielzeug/flux": "workspace:*",
    "@vielzeug/forge": "workspace:*",
    "@vielzeug/gesture": "workspace:*",
    "@vielzeug/herald": "workspace:*",
    "@vielzeug/illusionist": "workspace:*",
    "@vielzeug/keymap": "workspace:*",
    "@vielzeug/ledger": "workspace:*",
    "@vielzeug/lingua": "workspace:*",
    "@vielzeug/necromancer": "workspace:*",
    "@vielzeug/ore": "workspace:*",
    "@vielzeug/postmaster": "workspace:*",
    "@vielzeug/prism": "workspace:*",
    "@vielzeug/pulse": "workspace:*",
    "@vielzeug/refine": "workspace:*",
    "@vielzeug/ripple": "workspace:*",
    "@vielzeug/rune": "workspace:*",
    "@vielzeug/sandbox": "workspace:*",
    "@vielzeug/scout": "workspace:*",
    "@vielzeug/sentinel": "workspace:*",
    "@vielzeug/spell": "workspace:*",
    "@vielzeug/tempo": "workspace:*",
    "@vielzeug/vault": "workspace:*",
    "@vielzeug/ward": "workspace:*",
    "@vielzeug/wayfinder": "workspace:*"
  },
  "devDependencies": {
    "@vielzeug/assay": "workspace:*",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "4.1.10"
  }
}
