{
  "name": "vielzeug-motors-demo",
  "private": true,
  "version": "0.0.0",
  "description": "Vielzeug Motors — a fictional luxury car eShop demo showcasing @vielzeug packages working together, built with @vielzeug/refine + @vielzeug/ore.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "VIELZEUG_LOCAL_DEV=1 vite",
    "build": "tsc && vite build",
    "build:local": "node --experimental-strip-types scripts/write-local-tsconfig.ts && tsc -p tsconfig.local-dev.json && VIELZEUG_LOCAL_DEV=1 vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vielzeug/arsenal": "^1.1.2",
    "@vielzeug/clockwork": "^1.1.2",
    "@vielzeug/coins": "^1.0.5",
    "@vielzeug/conduit": "^1.0.4",
    "@vielzeug/courier": "link:../../packages/courier",
    "@vielzeug/dnd": "^1.2.2",
    "@vielzeug/familiar": "^1.0.6",
    "@vielzeug/flux": "^1.0.8",
    "@vielzeug/forge": "^1.4.0",
    "@vielzeug/herald": "^1.0.5",
    "@vielzeug/lingua": "^1.1.4",
    "@vielzeug/orbit": "^1.1.3",
    "@vielzeug/ore": "^1.3.0",
    "@vielzeug/prism": "^1.1.7",
    "@vielzeug/refine": "^1.8.0",
    "@vielzeug/ripple": "^1.3.0",
    "@vielzeug/rune": "^1.1.2",
    "@vielzeug/sandbox": "^1.2.2",
    "@vielzeug/scout": "^1.1.7",
    "@vielzeug/scroll": "^1.1.4",
    "@vielzeug/sourcerer": "^1.1.0",
    "@vielzeug/spell": "^1.2.2",
    "@vielzeug/tempo": "^1.0.5",
    "@vielzeug/vault": "^1.0.4",
    "@vielzeug/ward": "^1.0.5",
    "@vielzeug/wayfinder": "^1.0.4"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
