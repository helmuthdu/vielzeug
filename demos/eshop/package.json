{
  "name": "vielzeug-motors-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Vielzeug Motors — a fictional luxury car eShop demo showcasing @vielzeug packages working together, built with @vielzeug/refine + @vielzeug/ore.",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build:local": "node --experimental-strip-types scripts/write-local-tsconfig.ts && tsc -p tsconfig.local-dev.json && VIELZEUG_LOCAL_DEV=1 vite build",
    "dev": "vite",
    "dev:local": "VIELZEUG_LOCAL_DEV=1 vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vielzeug/arsenal": "^2.0.1",
    "@vielzeug/clockwork": "^2.0.1",
    "@vielzeug/coins": "link:../../packages/coins",
    "@vielzeug/conduit": "link:../../packages/conduit",
    "@vielzeug/courier": "link:../../packages/courier",
    "@vielzeug/dnd": "link:../../packages/dnd",
    "@vielzeug/familiar": "link:../../packages/familiar",
    "@vielzeug/flux": "^2.0.3",
    "@vielzeug/forge": "^2.0.2",
    "@vielzeug/herald": "^2.0.0",
    "@vielzeug/lingua": "link:../../packages/lingua",
    "@vielzeug/orbit": "link:../../packages/orbit",
    "@vielzeug/ore": "^2.0.3",
    "@vielzeug/prism": "^2.1.1",
    "@vielzeug/pulse": "^2.1.1",
    "@vielzeug/refine": "^2.1.0",
    "@vielzeug/ripple": "^2.1.0",
    "@vielzeug/rune": "^2.0.0",
    "@vielzeug/sandbox": "^2.0.0",
    "@vielzeug/scout": "link:../../packages/scout",
    "@vielzeug/scroll": "^2.0.1",
    "@vielzeug/sourcerer": "link:../../packages/sourcerer",
    "@vielzeug/spell": "^2.0.1",
    "@vielzeug/tempo": "link:../../packages/tempo",
    "@vielzeug/vault": "^2.1.0",
    "@vielzeug/ward": "^2.0.0",
    "@vielzeug/wayfinder": "^2.0.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
